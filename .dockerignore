# ---- VCS / CI ---------------------------------------------------------
.git/
.gitignore
.github/

# ---- Secrets / env: must never enter the image ------------------------
.env
.env.*
*.env
.venv/
venv/
env/

# ---- Python caches & build artifacts ---------------------------------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# ---- Node / desktop-shell build output (not needed by the server) -----
node_modules/
electron-shell/node_modules/
electron-shell/release/
desktop-pet/src-tauri/target/
desktop-pet/
electron-shell/

# ---- Runtime state (local only; regenerated at run time) -------------
# Phase 5 (SOU-62): backend/sou.db is runtime state too - the SQLite fallback
# the entrypoint migrates on first start. Baking a developer's database into a
# public image would ship its agents, events and join keys, so every database
# file and journal is excluded by shape, not just by name.
state.json
agents-state.json
join-keys.json
runtime-config.json
sou.db
backend/sou.db
*.db
*.db-wal
*.db-shm
*.db-journal
*.log
*.out
*.pid
*.backup*
*.original
healthcheck.log
backend.log
assets/bg-history/
assets/home-favorites/

# ---- Worker-local tooling (never shipped) ----------------------------
.tooling/

# ---- OS / editor cruft ------------------------------------------------
.DS_Store
*.swp
Thumbs.db

# ---- Docs (kept small; not served by the backend) --------------------
docs/

# ---- Release bundles --------------------------------------------------
dist/Star-Office-UI-release-*/
