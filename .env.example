# Star Office UI (the Lodge) - environment example. Copy to .env; backend/run.sh loads it.
# Never commit real tokens: keep .env out of git (it is ignored) and use SOPS in a deployment.

# Database: unset = SQLite at backend/sou.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/star_office

# Which routes this process serves: dev (default) | ingest | public  (docs/public-lodge.md)
# SOU_MODE=dev

# Per-agent ingest tokens, sha256(token):agent pairs or a path to a JSON file.
# Mint with: uv run python backend/tokens.py new <agent>
# Mandatory when SOU_MODE=ingest; optional (with a warning) in dev.
# SOU_INGEST_TOKENS=<sha256hex>:my-bot

# Requests per second (burst) allowed per token
# SOU_INGEST_RATE_LIMIT=20

# Port
# STAR_BACKEND_PORT=19000
